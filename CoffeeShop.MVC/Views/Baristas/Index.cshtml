@model IEnumerable<CoffeeShop.Infrastructure.Models.BaristaModel>

@{
    ViewData["Title"] = "Список бариста";
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h2>Список бариста (CoffeeShop.MVC)</h2>
        <a asp-action="Create" class="btn btn-primary">+ Додати нового бариста</a>
    </div>

    <table class="table table-striped table-hover shadow-sm">
        <thead class="table-dark">
            <tr>
                <th>ID</th>
                <th>Повне ім'я</th>
                <th>Досвід (років)</th>
                <th>Зміна</th>
                <th>Погодинна ставка (грн)</th>
                <th>Сертифікований</th>
                <th>Дії</th>
            </tr>
        </thead>
        <tbody>
@foreach (var item in Model) {
            <tr>
                <td>@item.Id</td>
                <td><strong>@item.FullName</strong></td>
                <td>@item.ExperienceYears</td>
                <td><span class="badge bg-secondary">@item.Shift</span></td>
                <td>@item.HourlyRate.ToString("F2")</td>
                <td>@(item.IsCertified ? "Так" : "Ні")</td>
                <td>
                    <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-outline-warning">Редагувати</a>
                    <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-sm btn-outline-info">Деталі</a>
                    <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-sm btn-outline-danger">Видалити</a>
                </td>
            </tr>
}
        </tbody>
    </table>
</div>
