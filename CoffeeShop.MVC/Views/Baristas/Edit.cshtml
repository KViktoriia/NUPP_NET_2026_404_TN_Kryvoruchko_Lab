@model CoffeeShop.Infrastructure.Models.BaristaModel

@{
    ViewData["Title"] = "Редагувати бариста";
}

<div class="container mt-4">
    <h2>Редагувати дані бариста</h2>
    <hr />
    <div class="row">
        <div class="col-md-6">
            <form asp-action="Edit">
                <div asp-validation-summary="ModelOnly" class="text-danger"></div>
                <input type="hidden" asp-for="Id" />
                <div class="mb-3">
                    <label asp-for="FullName" class="form-label">Повне ім'я</label>
                    <input asp-for="FullName" class="form-control" />
                    <span asp-validation-for="FullName" class="text-danger"></span>
                </div>
                <div class="mb-3">
                    <label asp-for="ExperienceYears" class="form-label">Досвід роботи (років)</label>
                    <input asp-for="ExperienceYears" type="number" class="form-control" />
                    <span asp-validation-for="ExperienceYears" class="text-danger"></span>
                </div>
                <div class="mb-3">
                    <label asp-for="Shift" class="form-label">Зміна</label>
                    <select asp-for="Shift" class="form-select">
                        <option value="Ранок">Ранок</option>
                        <option value="День">День</option>
                        <option value="Вечір">Вечір</option>
                    </select>
                    <span asp-validation-for="Shift" class="text-danger"></span>
                </div>
                <div class="mb-3">
                    <label asp-for="HourlyRate" class="form-label">Погодинна ставка (грн)</label>
                    <input asp-for="HourlyRate" type="number" step="0.5" class="form-control" />
                    <span asp-validation-for="HourlyRate" class="text-danger"></span>
                </div>
                <div class="mb-3 form-check">
                    <input class="form-check-input" asp-for="IsCertified" />
                    <label class="form-check-label" asp-for="IsCertified">Має професійний сертифікат</label>
                </div>
                <div class="mb-3">
                    <input type="submit" value="Оновити" class="btn btn-warning" />
                    <a asp-action="Index" class="btn btn-secondary">Назад до списку</a>
                </div>
            </form>
        </div>
    </div>
</div>
