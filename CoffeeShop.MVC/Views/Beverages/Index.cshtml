@model IEnumerable<CoffeeShop.Infrastructure.Models.BeverageModel>

@{
    ViewData["Title"] = "Список напоїв";
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h2>Список напоїв (CoffeeShop.MVC)</h2>
        <a asp-action="Create" class="btn btn-primary">+ Додати новий напій</a>
    </div>

    <table class="table table-striped table-hover shadow-sm">
        <thead class="table-dark">
            <tr>
                <th>ID</th>
                <th>Назва</th>
                <th>Ціна (грн)</th>
                <th>Об'єм (мл)</th>
                <th>В наявності</th>
                <th>Дії</th>
            </tr>
        </thead>
        <tbody>
@foreach (var item in Model) {
            <tr>
                <td>@item.Id</td>
                <td><strong>@item.Name</strong></td>
                <td>@item.Price.ToString("F2")</td>
                <td>@item.VolumeMl мл</td>
                <td><span class="badge @(item.IsAvailable ? "bg-success" : "bg-secondary")">@(item.IsAvailable ? "Доступний" : "Немає")</span></td>
                <td>
                    <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-outline-warning">Редагувати</a>
                    <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-sm btn-outline-info">Деталі</a>
                    <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-sm btn-outline-danger">Видалити</a>
                </td>
            </tr>
}
        </tbody>
    </table>
</div>
